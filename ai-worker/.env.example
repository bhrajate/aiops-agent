# AI Worker environment (AIOPS_ prefix). Copy to .env and adjust.

AIOPS_TEMPORAL_HOSTPORT=localhost:7233
AIOPS_TEMPORAL_NAMESPACE=default
AIOPS_TASK_QUEUE=investigation-ai

# Single DB writer -- worker writes back here, never touches the DB directly.
AIOPS_CONTROL_INTERNAL_URL=http://localhost:8090

# Model gateway: mock (default, deterministic, no key) | anthropic
AIOPS_MODEL_PROVIDER=mock
AIOPS_ANTHROPIC_API_KEY=
AIOPS_ANTHROPIC_MODEL=claude-opus-4-8[1M]

AIOPS_HTTP_TIMEOUT_SEC=15
# Worker-wide concurrent activity cap -- this is also the cap on concurrent
# model calls. Set on the Worker (not as an in-activity semaphore) so queued
# activities have not started their start_to_close clock yet.
# Do not set it too low: bookkeeping activities (record_phase / record_event)
# share these slots and have a 30s timeout.
AIOPS_MAX_CONCURRENT_ACTIVITIES=16

# Knowledge Service embeddings (pgvector RAG): mock (default, deterministic,
# no key) | anthropic | openai | local (last three are stubs / TODO).
AIOPS_EMBEDDING_PROVIDER=mock

# Direct DB access for the Evaluation service (evaluation_runs) and the
# knowledge reindex CLI. Only needed for --from-db / --write / reindex; unit
# tests and offline replay do not require it.
AIOPS_DB_DSN=postgres://aiops:aiops@localhost:5432/aiops?sslmode=disable
