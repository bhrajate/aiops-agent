# 复制为 .env.prod 并填入真实值(切勿提交 .env.prod)。
# 供 docker-compose.prod.yml overlay 注入密钥。

# 业务库(生产建议托管 PG + sslmode=require)
AIOPS_DB_DSN=postgres://aiops:CHANGE_ME@postgres:5432/aiops?sslmode=disable

# 内部 API 共享密钥(必填)
AIOPS_INTERNAL_TOKEN=CHANGE_ME_internal_token

# Webhook HMAC(可选;留空则开发放行)
AIOPS_WEBHOOK_SECRET=

# 认证
AIOPS_AUTH_MODE=hs256
AIOPS_AUTH_HS256_SECRET=CHANGE_ME_dev_secret

# 对象存储
AIOPS_S3_ACCESS_KEY=minioadmin
AIOPS_S3_SECRET_KEY=minioadmin

# 模型
AIOPS_MODEL_PROVIDER=mock
AIOPS_ANTHROPIC_API_KEY=
AIOPS_ANTHROPIC_MODEL=claude-opus-4-8[1M]
