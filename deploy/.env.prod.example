# 复制为 .env.prod 并填入真实值(切勿提交 .env.prod)。
# 供 docker-compose.prod.yml overlay 注入密钥。

# ---- 运行环境(生产护栏总开关)----
# 这个 overlay 是**生产形态**而非生产配置:默认 hs256 + mock provider + mock 数据源
# + 无观测后端。因此默认 development —— 设成 production 会(正确地)因为这几项而
# 拒绝启动。真上生产走 Helm(deploy/helm,values-prod.yaml 已声明 production/live)。
#
# 若确要在本 overlay 下试生产模式,以下三项必须同时改,否则各组件会 fail-fast:
#   AIOPS_ENV=production
#   AIOPS_DATASOURCE=live            # 否则 cluster-agent 拒绝启动(mock 假证据)
#   AIOPS_MODEL_PROVIDER=anthropic   # 否则 ai-worker 拒绝启动(编造的诊断结论)
# 并补齐:AUTH_MODE=oidc + OIDC issuer/JWKS、WEBHOOK_SECRET、至少一个观测后端 URL、
# 集群维度 label。核对:control-plane validate-config
AIOPS_ENV=development
AIOPS_DATASOURCE=mock

# 业务库(生产建议托管 PG + sslmode=require)
AIOPS_DB_DSN=postgres://aiops:CHANGE_ME@postgres:5432/aiops?sslmode=disable

# 内部 API 共享密钥(必填)
AIOPS_INTERNAL_TOKEN=CHANGE_ME_internal_token

# Webhook HMAC(可选;留空则开发放行)
AIOPS_WEBHOOK_SECRET=

# 认证
AIOPS_AUTH_MODE=hs256
AIOPS_AUTH_HS256_SECRET=CHANGE_ME_dev_secret

# 对象存储
AIOPS_S3_ACCESS_KEY=minioadmin
AIOPS_S3_SECRET_KEY=minioadmin

# 模型
AIOPS_MODEL_PROVIDER=mock
AIOPS_ANTHROPIC_API_KEY=
AIOPS_ANTHROPIC_MODEL=claude-opus-4-8[1M]
